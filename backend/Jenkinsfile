
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Recuperation du projet depuis GitHub'
                checkout scm
            }
        }

        stage('Tests unitaires') {
            steps {
                dir('backend') {
                    echo 'Execution des tests unitaires'
                    sh 'mvn -B test'
                }
            }
        }

        stage('Build') {
            steps {
                dir('backend') {
                    echo 'Creation du livrable'
                    sh 'mvn -B -DskipTests package'
                }
            }
        }

        stage('Archivage') {
            steps {
                archiveArtifacts artifacts: 'backend/target/*.jar',
                                 fingerprint: true
            }
        }
    }
}
//thousand day, thousand night, hope I embody the spirit, and continue this fight
